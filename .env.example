# Answer generation: Kaggle notebook exposing an Ollama-compatible endpoint
LLM_PROVIDER=kaggle
KAGGLE_LLM_URL=https://your-tunnel.example
KAGGLE_LLM_MODEL=your-generation-model
KAGGLE_LLM_NUM_CTX=8192
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=180

# Local RAG: Qwen3 query/document embeddings and PostgreSQL/pgvector
PGHOST=localhost
PGPORT=5432
PGDATABASE=ragdb
PGUSER=postgres
PGPASSWORD=change_me
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MODEL_REVISION=main
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=8
# auto selects CUDA when available; use cpu or cuda to force a device.
EMBEDDING_DEVICE=auto
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MODEL_REVISION=main
# Upper bound for one retrieval query. Must stay above the composite queries
# built by the discussion provider, which truncates to this same value.
MAX_QUERY_CHARS=2000
IVFFLAT_MAX_LISTS=100
IVFFLAT_PROBES=100
PREPROCESSING_VERSION=clean-v2-chunk-v3-context
PIPELINE_VERSION=rag-pipeline-2026.09.01-context-v1

# Discussion execution
DISCUSSION_MAX_WORKERS=5
RECENT_EXCHANGES_TO_KEEP=5
# Per-turn tool-round budget for knowledge-base retrieval. Each agent turn
# starts with a fresh budget because agent state is checkpointed for the whole
# discussion; the budget is not a lifetime allowance.
MAX_TOOL_ROUNDS=1
# Per-turn web-search round budget. Kept separate from MAX_TOOL_ROUNDS so a
# knowledge-base round cannot consume the web fallback: the prompt only reaches
# "use live_web_search if the knowledge base is insufficient" when the web has a
# budget of its own. The web stays closed until the knowledge base has been
# consulted (or its best hit fell below MIN_TOP_SIMILARITY).
MAX_WEB_ROUNDS=1
# Individual web searches allowed per turn, within the web round budget above.
MAX_WEB_SEARCHES_PER_RUN=5
# Evidence items retrieved per discussion turn. The debate needs broader
# context than a single-shot agent answer.
DISCUSSION_TOP_K=5
SEARCH_PROVIDER=duckduckgo
# Set to postgres only if durable LangGraph checkpoints are required.
CHECKPOINT_BACKEND=memory
