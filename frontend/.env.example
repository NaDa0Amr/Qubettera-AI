# ── Server-side (not visible to the browser) ────────────────────────────────
# Target for the Next.js proxy route handlers. In Docker this is the
# docker-compose service name; for local dev use http://localhost:8000.
FASTAPI_INTERNAL_URL=http://localhost:8000

# Set to true to synthesize mock SSE streams instead of proxying to FastAPI.
# Use for frontend-only development without a running backend.
MOCK_BACKEND=false

# ── Public (baked into the client JS bundle at build time) ──────────────────
NEXT_PUBLIC_APP_NAME=Multi-Agent Opinion Simulator
