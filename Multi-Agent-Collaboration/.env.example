# =============================================================================
# Intelligent Agent Framework — Example Environment Configuration
# Copy this file to .env and configure with your credentials.
# Do NOT commit .env to version control.
# =============================================================================

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose one: groq | openrouter | ollama
LLM_PROVIDER=groq

# Groq (Fast free-tier inference)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
# GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7

# OpenRouter (Alternative)
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_api_key
# LLM_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_MAX_TOKENS=2048
# LLM_TIMEOUT_SECONDS=60

# Ollama LLM (Alternative)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_NUM_CTX=4096

# W&B Serverless Inference (Alternative)
# LLM_PROVIDER=wandb
# WANDB_API_KEY=your_wandb_api_key_from_wandb_ai_authorize
# LLM_MODEL=Qwen/Qwen3.6-35B-A3B
# WANDB_BASE_URL=https://api.inference.wandb.ai/v1
# WANDB_PROJECT=your_team/your_project  # optional

# ── Retrieval (Direct Supabase pgvector + Kaggle Ollama) ──────────────────────
# Supabase PostgreSQL connection string with pgvector
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# Ngrok tunnel URL pointing to the running Kaggle Ollama notebook
KAGGLE_OLLAMA_URL=https://<your-ngrok-tunnel>.ngrok-free.dev

# Embedding model hosted on Kaggle Ollama
EMBEDDING_MODEL=qwen3-embedding:8b
RETRIEVAL_TOP_K=5
RETRIEVAL_TIMEOUT_SECONDS=180

# ── Live Search & Web Tools ──────────────────────────────────────────────────
# Search provider: 'duckduckgo' or 'tavily'
SEARCH_PROVIDER=duckduckgo

# Tavily Search API key (optional — works in keyless mode if omitted)
TAVILY_API_KEY=tvly-your-tavily-api-key

# Optional AlterLab proxy (for JS-rendered pages)
ALTERLAB_API_KEY=

# ── Memory & Windowing ───────────────────────────────────────────────────────
# Number of recent human turns to retain verbatim before summarizing
RECENT_EXCHANGES_TO_KEEP=5

# ── PostgreSQL Checkpointer (Optional — defaults to in-memory MemorySaver) ───
# Uncomment if you want durable checkpoint persistence across restarts:
# PGHOST=db.<project>.supabase.co
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres
# PGPASSWORD=your_password

# ── Observability & Tracing ──────────────────────────────────────────────────
LOG_LEVEL_CONSOLE=INFO
LOG_LEVEL_FILE=DEBUG
LLM_VERBOSE=false
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
