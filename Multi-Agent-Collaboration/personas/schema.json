{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "persona.schema.json",
  "title": "Persona",
  "description": "Unified schema for a single agent persona configuration file.",
  "type": "object",
  "required": [
    "id",
    "persona_id",
    "name",
    "background",
    "stance",
    "style",
    "communication_style",
    "expertise",
    "priorities",
    "retrieval_focus",
    "skepticism_level"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "persona_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "background": {"type": "string", "minLength": 1},
    "stance": {"type": "string", "minLength": 1},
    "style": {"type": "string", "minLength": 1},
    "communication_style": {"type": "string", "minLength": 1},
    "expertise": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "priorities": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "retrieval_focus": {"type": "string", "minLength": 1},
    "skepticism_level": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "default": "medium"
    },
    "personality_traits": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}